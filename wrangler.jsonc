{
  "name": "how-they-did-it",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Without this, browsers asking for /keystatic get the 404 page before the Worker ever runs.
    "run_worker_first": ["/keystatic", "/keystatic/*", "/api/keystatic/*"]
  }
}
