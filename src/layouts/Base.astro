---
import '../styles/site.css';
import { ui, siteName, social, localePath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** English path without leading slash, e.g. 'episodes' or 'episode/episode-3'. '' = home. */
  path: string;
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}
const { lang, path, title, description = '', image = '/images/site/banner.jpg', noindex = false } = Astro.props;
const t = ui[lang];
const site = 'https://www.canadianinvestigativejournalism.ca';
const other: Lang = lang === 'en' ? 'fr' : 'en';
const enUrl = site + localePath('en', path);
const frUrl = site + localePath('fr', path);
const canonical = lang === 'en' ? enUrl : frUrl;
const nav = [
  ['', t.home],
  ['episodes', t.episodes],
  ['text-interviews', t.interviews],
  ['videos', t.videos],
  ['about-us', t.about],
  ['contact', t.contact],
] as const;
// The original site shows this shorter menu on desktop and the full list in the phone menu.
const navDesktop = [
  ['about-us', t.aboutUs],
  ['episodes', t.episodes],
  ['text-interviews', t.articles],
  ['links', t.resources],
  ['contact', t.contact],
] as const;
const current = path.split('/')[0];
// Home page only: tells search engines what the site is. `<` is escaped so it can sit safely in a script tag.
const jsonLd = JSON.stringify([
  { '@context': 'https://schema.org', '@type': 'Organization', name: siteName, url: site, logo: `${site}/apple-touch-icon.png`, sameAs: social.map((s) => s.url) },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: siteName, url: site, inLanguage: ['en-CA', 'fr-CA'] },
]).replace(/</g, '\\u003c');
const fullTitle =path === '' ? siteName : `${title} | ${siteName}`;
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="fr-CA" href={frUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={site + image} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_CA' : 'en_CA'} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {path === '' && <script type="application/ld+json" set:html={jsonLd} />}
    <link rel="preload" href="/fonts/Sentient-Regular.otf" as="font" type="font/otf" crossorigin />
    <link rel="preload" href="/fonts/DMSans-Regular.ttf" as="font" type="font/ttf" crossorigin />
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <div class="banner"><img src="/images/site/banner.jpg" alt="" /></div>
    <header class="site-header" id="site-header">
      <div class="wrap bar">
        <a class="brand" href={localePath(lang)}>
          <img src="/images/site/logo-home-white.svg" alt={siteName} height="30" />
        </a>
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="main-nav" aria-label="Menu">☰</button>
        <nav aria-label="Main" id="main-nav">
          <ul class="nav-desktop">
            {navDesktop.map(([p, label]) => (
              <li>
                <a href={localePath(lang, p)} aria-current={current === p ? 'page' : undefined}>{label}</a>
              </li>
            ))}
            <li class="lang">
              <details class="lang-menu">
                <summary>{t.language}</summary>
                <ul>
                  <li><a href={localePath('en', path)} hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined}>English</a></li>
                  <li><a href={localePath('fr', path)} hreflang="fr-CA" lang="fr-CA" aria-current={lang === 'fr' ? 'true' : undefined}>Français</a></li>
                </ul>
              </details>
            </li>
          </ul>
          <ul class="nav-mobile">
            {nav.map(([p, label]) => (
              <li>
                <a href={localePath(lang, p)} aria-current={(p === '' ? path === '' : current === p) ? 'page' : undefined}>{label}</a>
              </li>
            ))}
            <li><a href={localePath('en', path)} hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined}>English</a></li>
            <li><a href={localePath('fr', path)} hreflang="fr-CA" lang="fr-CA" aria-current={lang === 'fr' ? 'true' : undefined}>Français</a></li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap foot">
        <div>
          <p class="foot-title">{t.follow}</p>
          <ul class="social">
            {social.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.name}</a></li>)}
          </ul>
        </div>
        <img src="/images/site/michener.png" alt="The Michener Awards / Les Prix Michener" width="260" height="136" loading="lazy" />
      </div>
    </footer>
    <script>
      const header = document.getElementById('site-header')!;
      const btn = header.querySelector('.menu-btn')!;
      btn.addEventListener('click', () => {
        const open = header.toggleAttribute('data-open');
        btn.setAttribute('aria-expanded', String(open));
      });
    </script>
  </body>
</html>
