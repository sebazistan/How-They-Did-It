---
import Base from '../layouts/Base.astro';
import { ui, localePath, type Lang } from '../i18n/ui';
import { getEpisodes, pages, pick, youtubeId } from '../lib/content';
const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];
const title = lang === 'fr' ? pages().videosTitleFr || t.videosTitle : t.videosTitle;
---

<Base lang={lang} path="videos" title={title}>
  <section class="wrap block">
    <h1 class="page-title">{title}</h1>
    <div class="stack">
      {getEpisodes().map((ep) => (
        <article class="entry">
          <h2><a href={localePath(lang, `episode/${ep.slug}`)}>{pick(ep, 'title', lang)}</a></h2>
          <p>{pick(ep, 'summary', lang)}</p>
          {youtubeId(ep.youtubeUrl) && (
            <div class="video">
              <iframe title={pick(ep, 'title', lang)} src={`https://www.youtube-nocookie.com/embed/${youtubeId(ep.youtubeUrl)}`} loading="lazy" allowfullscreen></iframe>
            </div>
          )}
        </article>
      ))}
    </div>
  </section>
</Base>
