---
import Base from '../layouts/Base.astro';
import { ui, social, contactEmail, web3formsKey, siteName, type Lang } from '../i18n/ui';
import { pages, pick, markdown } from '../lib/content';
const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];
const p = pages();
const title = lang === 'fr' ? p.contactHeadingFr || t.contactTitle : t.contactTitle;
const intro = pick(p, 'contactIntro', lang);
---

<Base lang={lang} path="contact" title={title} description={intro}>
  <section class="wrap block">
    <h1 class="page-title">{title}</h1>
    <p class="lead">{intro}</p>
    <div class="contact-grid">
      <img class="contact-img" src="/images/site/contact.jpg" alt="" loading="lazy" />
      <form id="contact-form" class="form" data-key={web3formsKey} data-email={contactEmail} data-sending={t.sending} data-sent={t.sent} data-failed={t.failed} data-subject={`${siteName} (${lang})`}>
        <input name="name" required autocomplete="name" placeholder={t.name} aria-label={t.name} />
        <input name="email" type="email" required autocomplete="email" placeholder={t.email} aria-label={t.email} />
        <textarea name="message" rows="6" required placeholder={t.message} aria-label={t.message}></textarea>
        <input type="text" name="botcheck" tabindex="-1" autocomplete="off" style="display:none" aria-hidden="true" />
        <button class="button send" type="submit">{t.send}</button>
        <p id="form-status" role="status"></p>
      </form>
    </div>
  </section>
  <section class="wrap block">
    <h2>{pick(p, 'contactDetailsHeading', lang)}</h2>
    <div class="prose" set:html={markdown(pick(p, 'contactDetails', lang))} />
    <p class="email-big"><a href={`mailto:${contactEmail}`}>{contactEmail}</a></p>
    <ul class="social">
      {social.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.name}</a></li>)}
    </ul>
  </section>
</Base>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status')!;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const d = form.dataset;
    const fd = new FormData(form);
    // No form key yet: open the visitor's email app instead of failing silently.
    if (!d.key) {
      const body = encodeURIComponent(`${fd.get('message')}\n\n${fd.get('name')} <${fd.get('email')}>`);
      location.href = `mailto:${d.email}?subject=${encodeURIComponent(d.subject!)}&body=${body}`;
      return;
    }
    fd.append('access_key', d.key);
    fd.append('subject', d.subject!);
    status.textContent = d.sending!;
    try {
      const r = await fetch('https://api.web3forms.com/submit', { method: 'POST', headers: { Accept: 'application/json' }, body: fd });
      const j = await r.json();
      if (j.success) { status.textContent = d.sent!; form.reset(); } else throw new Error('rejected');
    } catch {
      status.textContent = d.failed!;
    }
  });
</script>
