---
import Base from '../layouts/Base.astro';
import { ui, type Lang } from '../i18n/ui';
import { links, pick } from '../lib/content';
const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];
---

<Base lang={lang} path="links" title={t.resourcesTitle}>
  <section class="wrap block">
    <h1>{t.resourcesTitle}</h1>
    <ul class="links">
      {links().map((l) => (
        <li>
          <h3>{l.name}</h3>
          <p>{pick(l, 'desc', lang)}</p>
          <a class="button dark" href={l.url} rel="noopener" target="_blank">{t.visit}</a>
        </li>
      ))}
    </ul>
  </section>
</Base>
