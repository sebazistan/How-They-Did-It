---
import Base from '../layouts/Base.astro';
import { ui, type Lang } from '../i18n/ui';
import { links, pick } from '../lib/content';
const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];
---

<Base lang={lang} path="links" title={t.resourcesTitle}>
  <section class="wrap block">
    <div class="stack">
      {links().map((l) => (
        <article class="entry">
          <h2>{l.name}</h2>
          <p>{pick(l, 'desc', lang)}</p>
          <a class="button" href={l.url} rel="noopener" target="_blank">{t.clickHere}</a>
        </article>
      ))}
    </div>
  </section>
</Base>
